generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id           Int      @id @default(autoincrement())
  mediaId      String   @unique
  title        String
  subtitle     String
  songUrl      String
  imageUrl     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}